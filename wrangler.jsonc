{
	// Nama worker — sama dengan yang sudah ada agar URL tetap
	// https://socialmahjong.tsmc-mahjong.workers.dev
	"name": "socialmahjong",
	"main": "src/worker.js",
	"compatibility_date": "2026-08-01",
	// File statis (halaman publik + admin) ada di folder public/
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// Database D1 — setelah menjalankan `npx wrangler d1 create tsmc-db`,
	// salin "database_id" dari hasilnya dan tempel menggantikan teks di bawah.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tsmc-db",
			"database_id": "63599c87-9e87-4256-945a-c23a85b994d9"
		}
	]
}